# Arch Linux Console Live ISO - Minimal Package List

# --- [Boot & Base System] ---
base
linux
efibootmgr
dosfstools
mkinitcpio
mkinitcpio-archiso
arch-install-scripts
sudo

# --- [Shell] ---
zsh
zsh-completions
zsh-syntax-highlighting
zsh-history-substring-search
starship

# --- [Fonts] ---
ttf-firacode-nerd
wqy-microhei    # CJK glyphs for kmscon; FiraCode has none

# --- [Hardware Support] ---
intel-ucode
amd-ucode
# linux-firmware split up, without linux-firmware-nvidia (~100 MiB of nouveau and
# Tegra firmware; nouveau is blacklisted by nvidia-utils, nvidia-open brings its own)
linux-firmware-amd
linux-firmware-amdgpu
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-cirrus
linux-firmware-intel
linux-firmware-mediatek
linux-firmware-other
linux-firmware-radeon
linux-firmware-realtek
linux-firmware-ti
nvidia-open    # Nvidia driver for GTX 16xx / RTX 20xx and newer (blacklists nouveau)

# --- [CLI Utilities] ---
nano
less
kmscon
pango

# --- [Filesystem Tools] ---
ntfs-3g
exfatprogs
btrfs-progs
xfsprogs

# --- [Partition Tools] ---
parted
gptfdisk

# --- [Network] ---
networkmanager
bluez
bluez-utils
firewalld
iptables
